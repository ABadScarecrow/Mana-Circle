{
  "name": "mana-circle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:strict": "tsx --test tests/catalog-filter.test.ts tests/wishlist-import.test.ts tests/french-names.test.ts",
    "test:browser": "playwright test",
    "check": "npm test && npm run test:browser && npm run build",
    "admin": "tsx src/server/admin.ts",
    "import:scryfall": "tsx src/server/import-scryfall.ts",
    "commander-data": "tsx src/server/commander-data-cli.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
